#include <stdio.h>
#include <string.h>
int main()
{
    char type1[50], type2[50];
    printf("Enter first type expression: ");
    scanf("%s", type1);
    printf("Enter second type expression: ");
    scanf("%s", type2);
    /* Compare type expressions */
    if (strcmp(type1, type2) == 0)
    {
        printf("Equivalent\n");
    }
    else
    {
        printf("Not Equivalent\n");
    }
    return 0;
}
